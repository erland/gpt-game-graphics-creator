{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game Graphics Creator modular skills project configuration",
  "type": "object",
  "required": [
    "enabled",
    "resource_policy",
    "definitions"
  ],
  "properties": {
    "enabled": {
      "const": true
    },
    "resource_policy": {
      "const": "explicit"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "minLength": 1,
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "references": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "assets": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "scripts": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "requires_skills": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "schema": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
